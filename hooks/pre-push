#!/usr/bin/env bash
# Refuse direct pushes to main/master. Push a branch and open a PR instead.
# Bypass deliberately with: git push --no-verify
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: direct push to ${remote_ref#refs/heads/} blocked. Use a branch + PR." >&2
      exit 1 ;;
  esac
done
exit 0
